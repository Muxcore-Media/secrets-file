# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=secrets-file
# MUXCORE_MODULE_TOKEN=

# Secrets File Vault
# SECRETS_MASTER_KEY=   # hex-encoded 32-byte key (takes precedence; persisted to SECRETS_KEY_FILE on first start)
# SECRETS_KEY_FILE=/var/lib/secrets-file/master.key
# SECRETS_STORE=/var/lib/secrets-file/secrets.json
# SECRETS_GRPC_ADDR=127.0.0.1:9550
# SECRETS_ALLOWED_ROOT=/var/lib/secrets-file
