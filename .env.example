# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=secrets-file

# Secrets File Vault
# SECRETS_MASTER_KEY=   # hex-encoded 32-byte key (takes precedence)
# SECRETS_KEY_FILE=     # path to hex key file (auto-created if missing)
# SECRETS_STORE=secrets.json
# SECRETS_GRPC_ADDR=127.0.0.1:9550
# SECRETS_TLS_DIR=   # auto-generated TLS certs when unset
# MUXCORE_TLS_CERT=  # optional explicit server cert
# MUXCORE_TLS_KEY=   # optional explicit server key
