[Unit]
Description=MuxCore Module - secrets-file
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/secrets-file \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id secrets-file
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secrets-file

[Install]
WantedBy=multi-user.target
